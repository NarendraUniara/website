workflows:
  android-workflow:
    name: Embroidery Ledger Pro - Android Build
    max_build_duration: 30
    instance_type: linux
    environment:
      node: 20
      vars:
        PACKAGE_NAME: "com.embroidery.ledgerpro"
    scripts:
      - name: Install npm dependencies
        script: |
          npm install
      - name: Add Android platform
        script: |
          npx cap add android
      - name: Sync Capacitor
        script: |
          npx cap sync android
      - name: Build debug APK
        script: |
          cd android
          chmod +x ./gradlew
          ./gradlew assembleDebug
    artifacts:
      - android/app/build/outputs/**/*.apk
    publishing:
      email:
        recipients: []
